<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.App.Controls"
	xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
	xmlns:toolkit="using:CommunityToolkit.WinUI">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="PropertiesViewCardForeground" ResourceKey="TextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="PropertiesViewCardForeground" ResourceKey="TextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundPressed" ResourceKey="TextFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />
		</ResourceDictionary>
		<ResourceDictionary x:Key="HighContrast">
			<StaticResource x:Key="PropertiesViewCardForeground" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<Thickness x:Key="PropertiesViewCardPadding">0,6</Thickness>
	<GridLength x:Key="PropertiesViewCardDefaultLabelWidth">160</GridLength>
	<x:Double x:Key="PropertiesViewCardMinWidth">148</x:Double>
	<x:Double x:Key="PropertiesViewCardMinHeight">48</x:Double>
	<x:Double x:Key="PropertiesViewCardHeaderIconMaxSize">20</x:Double>
	<x:Double x:Key="PropertiesViewCardActionIconMaxSize">13</x:Double>
	<x:Double x:Key="PropertiesViewCardVerticalHeaderContentSpacing">8</x:Double>

	<x:Double x:Key="PropertiesViewCardWrapThreshold">300</x:Double>
	<x:Double x:Key="PropertiesViewCardRightThreshold">400</x:Double>
	<x:Double x:Key="PropertiesViewCardLeftThreshold">500</x:Double>

	<x:Double x:Key="PropertiesViewCardBitmapIconDisabledOpacity">0.4</x:Double>
	<Thickness x:Key="PropertiesViewCardHeaderIconMargin">0,0,12,0</Thickness>
	<Thickness x:Key="PropertiesViewCardHeaderMargin">0,0,24,0</Thickness>
	<Thickness x:Key="PropertiesViewCardActionIconMargin">14,0,0,0</Thickness>

	<Style BasedOn="{StaticResource TestPropertiesViewCardStyle}" TargetType="local:PropertiesViewCard" />

	<Style x:Key="TestPropertiesViewCardStyle" TargetType="local:PropertiesViewCard">
		<Setter Property="HorizontalAlignment" Value="Stretch" />

		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:PropertiesViewCard">

					<Grid
						x:Name="PART_RootGrid"
						Height="72"
						HorizontalAlignment="Stretch">
						<Grid.RowDefinitions>
							<RowDefinition x:Name="Row_Label" Height="Auto" />
							<RowDefinition x:Name="Row_Content" Height="*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition x:Name="Col_Label" Width="{StaticResource PropertiesViewCardDefaultLabelWidth}" />
							<ColumnDefinition x:Name="Col_Content" Width="*" />
						</Grid.ColumnDefinitions>

						<ContentPresenter
							x:Name="PART_HeaderPresenter"
							Grid.Row="0"
							Grid.RowSpan="2"
							Grid.Column="0"
							Margin="0,0,24,0"
							HorizontalAlignment="Left"
							VerticalAlignment="Center"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Center"
							Content="{TemplateBinding Header}"
							Foreground="HotPink" />

						<ContentPresenter
							x:Name="PART_ContentPresenter"
							Grid.Row="0"
							Grid.RowSpan="2"
							Grid.Column="1"
							HorizontalContentAlignment="Stretch"
							VerticalContentAlignment="Center"
							Content="{TemplateBinding Content}"
							Foreground="Green" />

						<TextBlock
							x:Name="testText"
							Grid.Row="0"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Foreground="Yellow"
							Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth, Mode=OneWay}" />


						<Viewbox x:Name="PART_ActionIconPresenterHolder" Visibility="Collapsed">
							<ContentPresenter x:Name="PART_ActionIconPresenter" Content="{TemplateBinding ActionIcon}" />
						</Viewbox>



						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal" />
								<VisualState x:Name="PointerOver">
									<VisualState.Setters />
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters />
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters />
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentAlignmentStates">
								<!--	This took a lot of working to get right, because of quirks with how 
										The Visual State Triggers failover during evaluation.
								
										Wrapped HAS to be first, with the EqualStateTrigger to catch the
										non default Vertical orientation, so we force that one to always
										use the Wrapped control layout.
								
										[ header ]	 
										========================================================
										[ content ]   [ action icon ]
								
								
										Then if the first trigger fails, it moves to the next so we are now
										working with the Horizontal orientation, and we use the ControlSizeTrigger
										to handle how we lay out the elements based on breakpoints
								
										Left is the default state so we do that after Wrapped
													|											|
										[ header ]	|	[ content ]  [ action icon ]			|
													|											|
								
								
										Right is the middle ground between narrow and wide
													|											|
										[ header ]	|				[ content ] [ action icon ]	|
													|											|
								-->

								<VisualState x:Name="Wrapped">
									<VisualState.StateTriggers>

										<!--  Vertical ALWAYS Wrapped  -->
										<toolkit:IsEqualStateTrigger Value="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}}" To="Vertical" />

										<!--  Horizontal small width  -->
										<toolkit:ControlSizeTrigger
											MinWidth="0"
											MaxWidth="{StaticResource PropertiesViewCardWrapThreshold}"
											TargetElement="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.StateTriggers>
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="#110000FF" />
									</VisualState.Setters>

								</VisualState>

								<VisualState x:Name="Left">
									<VisualState.StateTriggers>

										<!--  Horizontal large width  -->
										<toolkit:ControlSizeTrigger
											MinWidth="{StaticResource PropertiesViewCardWrapThreshold}"
											MaxWidth="{StaticResource PropertiesViewCardRightThreshold}"
											TargetElement="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.StateTriggers>
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="#11FF0000" />
									</VisualState.Setters>

								</VisualState>

								<VisualState x:Name="Right">
									<VisualState.StateTriggers>

										<!--  Horizontal medium width  -->
										<toolkit:ControlSizeTrigger MinWidth="{StaticResource PropertiesViewCardRightThreshold}" TargetElement="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.StateTriggers>
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="#1100FF00" />
									</VisualState.Setters>

								</VisualState>

							</VisualStateGroup>


							<VisualStateGroup x:Name="OrientationStates">
								<VisualState x:Name="Horizontal">
									<VisualState.Setters>
										<Setter Target="testText.Foreground" Value="#FF0000" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Vertical">
									<VisualState.Setters>
										<Setter Target="testText.Foreground" Value="#00FF00" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentVisibilityStates">
								<VisualState x:Name="Visible" />
								<VisualState x:Name="Collapsed">
									<VisualState.Setters />
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentSpacingStates">
								<VisualState x:Name="NoContentSpacing" />
								<VisualState x:Name="ContentSpacing">
									<VisualState.Setters />
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Grid>

				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>



</ResourceDictionary>
