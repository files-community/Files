<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:Files.App.Controls"
	xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
	xmlns:toolkit="using:CommunityToolkit.WinUI">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Default">
			<StaticResource x:Key="PropertiesViewCardActionIconForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundPointerOver" ResourceKey="AccentTextillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardHeaderForeground" ResourceKey="TextFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardContentForeground" ResourceKey="TextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardBackground" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundDisabled" ResourceKey="SubtleFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />

			<StaticResource x:Key="PropertiesViewCardInnerCornerRadius" ResourceKey="ControlCornerRadius" />
			<StaticResource x:Key="PropertiesViewCardCornerRadius" ResourceKey="OverlayCornerRadius" />
			<Thickness x:Key="PropertiesViewCardBorderThickness">0</Thickness>
			<Thickness x:Key="PropertiesViewCardPadding">0,8</Thickness>
		</ResourceDictionary>
		<ResourceDictionary x:Key="Light">
			<StaticResource x:Key="PropertiesViewCardActionIconForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundPointerOver" ResourceKey="AccentTextillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardHeaderForeground" ResourceKey="TextFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundPressed" ResourceKey="AccentTextFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardContentForeground" ResourceKey="TextFillColorPrimaryBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundPointerOver" ResourceKey="TextFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundPressed" ResourceKey="TextFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundDisabled" ResourceKey="TextFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardBackground" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundDisabled" ResourceKey="SubtleFillColorDisabledBrush" />

			<StaticResource x:Key="PropertiesViewCardBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushDisabled" ResourceKey="SubtleFillColorTransparentBrush" />

			<StaticResource x:Key="PropertiesViewCardInnerCornerRadius" ResourceKey="ControlCornerRadius" />
			<StaticResource x:Key="PropertiesViewCardCornerRadius" ResourceKey="OverlayCornerRadius" />
			<Thickness x:Key="PropertiesViewCardBorderThickness">0</Thickness>
			<Thickness x:Key="PropertiesViewCardPadding">0,8</Thickness>
		</ResourceDictionary>
		<ResourceDictionary x:Key="HighContrast">
			<StaticResource x:Key="PropertiesViewCardActionIconForeground" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardActionIconForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />

			<StaticResource x:Key="PropertiesViewCardHeaderForeground" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardHeaderForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />

			<StaticResource x:Key="PropertiesViewCardContentForeground" ResourceKey="SystemColorButtonTextColorBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardContentForegroundDisabled" ResourceKey="SystemControlDisabledBaseMediumLowBrush" />

			<StaticResource x:Key="PropertiesViewCardBackground" ResourceKey="SystemColorButtonFaceColorBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundPointerOver" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundPressed" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBackgroundDisabled" ResourceKey="SystemControlTransparentBrush" />

			<StaticResource x:Key="PropertiesViewCardBorderBrush" ResourceKey="SystemControlTransparentBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushPressed" ResourceKey="SystemColorHighlightColorBrush" />
			<StaticResource x:Key="PropertiesViewCardBorderBrushDisabled" ResourceKey="SystemControlTransparentBrush" />

			<StaticResource x:Key="PropertiesViewCardInnerCornerRadius" ResourceKey="ControlCornerRadius" />
			<StaticResource x:Key="PropertiesViewCardCornerRadius" ResourceKey="OverlayCornerRadius" />
			<Thickness x:Key="PropertiesViewCardBorderThickness">2</Thickness>
			<Thickness x:Key="PropertiesViewCardPadding">0,6</Thickness>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>

	<GridLength x:Key="PropertiesViewCardDefaultLabelWidth">160</GridLength>

	<x:Double x:Key="PropertiesViewCardMinWidth">148</x:Double>
	<x:Double x:Key="PropertiesViewCardMinHeight">48</x:Double>
	<x:Double x:Key="PropertiesViewCardActionIconMaxSize">13</x:Double>
	<x:Double x:Key="PropertiesViewCardVerticalHeaderContentSpacing">8</x:Double>

	<x:Double x:Key="PropertiesViewCardWrapThreshold">360</x:Double>
	<x:Double x:Key="PropertiesViewCardRightThreshold">520</x:Double>
	<x:Double x:Key="PropertiesViewCardLeftThreshold">640</x:Double>

	<Thickness x:Key="PropertiesViewCardHeaderIconMargin">12,0,12,0</Thickness>
	<Thickness x:Key="PropertiesViewCardHeaderMargin">0,8,24,8</Thickness>
	<Thickness x:Key="PropertiesViewCardContentMargin">0,8,0,8</Thickness>
	<Thickness x:Key="PropertiesViewCardActionIconMargin">12,0,12,0</Thickness>

	<HorizontalAlignment x:Key="PropertiesViewCardLeftHorizontalAlignment">Left</HorizontalAlignment>
	<HorizontalAlignment x:Key="PropertiesViewCardRightHorizontalAlignment">Right</HorizontalAlignment>
	<HorizontalAlignment x:Key="PropertiesViewCardWrappedHorizontalAlignment">Stretch</HorizontalAlignment>
	<VerticalAlignment x:Key="PropertiesViewCardLeftVerticallignment">Center</VerticalAlignment>
	<VerticalAlignment x:Key="PropertiesViewCardRightVerticalAlignment">Center</VerticalAlignment>
	<VerticalAlignment x:Key="PropertiesViewCardWrappedVerticalAlignment">Center</VerticalAlignment>


	<HorizontalAlignment x:Key="PropertiesViewCardLabelHorizontalAlignment">Stretch</HorizontalAlignment>
	<VerticalAlignment x:Key="PropertiesViewCardLabelVerticalAlignment">Center</VerticalAlignment>

	<Style BasedOn="{StaticResource DefaultPropertiesViewCardStyle}" TargetType="local:PropertiesViewCard" />

	<Style x:Key="DefaultPropertiesViewCardStyle" TargetType="local:PropertiesViewCard">
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="MinHeight" Value="{StaticResource PropertiesViewCardMinHeight}" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{ThemeResource PropertiesViewCardContentForeground}" />
		<Setter Property="BorderThickness" Value="{ThemeResource PropertiesViewCardBorderThickness}" />
		<Setter Property="MinWidth" Value="{StaticResource PropertiesViewCardMinWidth}" />
		<Setter Property="LabelWidth" Value="{StaticResource PropertiesViewCardDefaultLabelWidth}" />
		<Setter Property="Padding" Value="{ThemeResource PropertiesViewCardPadding}" />
		<Setter Property="IsTabStop" Value="False" />
		<Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
		<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
		<Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
		<Setter Property="FontWeight" Value="Normal" />
		<Setter Property="FocusVisualMargin" Value="-3" />
		<Setter Property="LeftBreakpointHorizontalContentAlignment" Value="{StaticResource PropertiesViewCardLeftHorizontalAlignment}" />
		<Setter Property="RightBreakpointHorizontalContentAlignment" Value="{StaticResource PropertiesViewCardRightHorizontalAlignment}" />
		<Setter Property="WrappedBreakpointHorizontalContentAlignment" Value="{StaticResource PropertiesViewCardWrappedHorizontalAlignment}" />
		<Setter Property="LeftBreakpointVerticalContentAlignment" Value="{StaticResource PropertiesViewCardLeftVerticallignment}" />
		<Setter Property="RightBreakpointVerticalContentAlignment" Value="{StaticResource PropertiesViewCardRightVerticalAlignment}" />
		<Setter Property="WrappedBreakpointVerticalContentAlignment" Value="{StaticResource PropertiesViewCardWrappedVerticalAlignment}" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="local:PropertiesViewCard">

					<Border
						x:Name="PART_RootBorder"
						MinWidth="{TemplateBinding MinWidth}"
						MinHeight="{TemplateBinding MinHeight}"
						MaxWidth="{TemplateBinding MaxWidth}"
						Margin="{TemplateBinding Margin}"
						Padding="{TemplateBinding Padding}"
						HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
						VerticalAlignment="{TemplateBinding VerticalAlignment}"
						Background="{TemplateBinding Background}"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						CornerRadius="{TemplateBinding CornerRadius}">
						<Grid
							x:Name="PART_RootGrid"
							HorizontalAlignment="Stretch"
							muxc:AnimatedIcon.State="Normal"
							Background="{ThemeResource PropertiesViewCardBackground}"
							BorderBrush="{ThemeResource PropertiesViewCardBorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{ThemeResource PropertiesViewCardInnerCornerRadius}">
							<Grid.RowDefinitions>
								<RowDefinition x:Name="Row_Label" Height="Auto" />
								<RowDefinition x:Name="Row_Content" Height="*" />
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition x:Name="Col_ActionIcon" Width="Auto" />
								<ColumnDefinition x:Name="Col_Label" Width="{Binding LabelWidth, RelativeSource={RelativeSource TemplatedParent}}" />
								<ColumnDefinition x:Name="Col_Content" Width="*" />
							</Grid.ColumnDefinitions>

							<ContentPresenter
								x:Name="PART_HeaderPresenter"
								Grid.Row="0"
								Grid.RowSpan="2"
								Grid.Column="1"
								Grid.ColumnSpan="1"
								Margin="{StaticResource PropertiesViewCardHeaderMargin}"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								HorizontalContentAlignment="{StaticResource PropertiesViewCardLabelHorizontalAlignment}"
								VerticalContentAlignment="{StaticResource PropertiesViewCardLabelVerticalAlignment}"
								Content="{TemplateBinding Header}"
								ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
								FontFamily="{TemplateBinding FontFamily}"
								FontSize="{TemplateBinding FontSize}"
								FontWeight="{TemplateBinding FontWeight}"
								Foreground="{TemplateBinding Foreground}"
								HighContrastAdjustment="None"
								TextWrapping="WrapWholeWords" />

							<ContentPresenter
								x:Name="PART_ContentPresenter"
								Grid.Row="0"
								Grid.RowSpan="2"
								Grid.Column="2"
								Grid.ColumnSpan="1"
								Margin="{StaticResource PropertiesViewCardContentMargin}"
								HorizontalContentAlignment="{Binding LeftBreakpointHorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
								VerticalContentAlignment="{Binding LeftBreakpointVerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
								Content="{TemplateBinding Content}"
								Foreground="{TemplateBinding Foreground}"
								TextWrapping="WrapWholeWords" />

							<Border
								x:Name="testText"
								Grid.Row="0"
								Grid.RowSpan="2"
								Grid.Column="0"
								Grid.ColumnSpan="3"
								Width="16"
								Height="16"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Background="Yellow"
								Canvas.ZIndex="9999"
								Visibility="Collapsed" />


							<Viewbox
								x:Name="PART_ActionIconPresenterHolder"
								Grid.Row="0"
								Grid.RowSpan="2"
								Grid.Column="0"
								Grid.ColumnSpan="1"
								MaxWidth="{ThemeResource PropertiesViewCardActionIconMaxSize}"
								MaxHeight="{ThemeResource PropertiesViewCardActionIconMaxSize}"
								Margin="{StaticResource PropertiesViewCardActionIconMargin}"
								Visibility="Collapsed">
								<ContentPresenter
									x:Name="PART_ActionIconPresenter"
									Content="{TemplateBinding ActionIcon}"
									Foreground="{ThemeResource PropertiesViewCardActionIconForeground}" />
							</Viewbox>

						</Grid>

						<VisualStateManager.VisualStateGroups>
							<VisualStateGroup x:Name="CommonStates">
								<VisualState x:Name="Normal">
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="{ThemeResource PropertiesViewCardBackground}" />
										<Setter Target="PART_HeaderPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForeground}" />
										<Setter Target="PART_ActionIconPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForeground}" />
										<Setter Target="PART_RootGrid.BorderBrush" Value="{ThemeResource PropertiesViewCardBorderBrush}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="PointerOver">
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="{ThemeResource PropertiesViewCardBackgroundPointerOver}" />
										<Setter Target="PART_HeaderPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForegroundPointerOver}" />
										<Setter Target="PART_ActionIconPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForegroundPointerOver}" />
										<Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource PropertiesViewCardContentForegroundPointerOver}" />
										<Setter Target="PART_RootGrid.BorderBrush" Value="{ThemeResource PropertiesViewCardBorderBrushPointerOver}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Pressed">
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="{ThemeResource PropertiesViewCardBackgroundPressed}" />
										<Setter Target="PART_HeaderPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForegroundPressed}" />
										<Setter Target="PART_ActionIconPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForegroundPressed}" />
										<Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource PropertiesViewCardContentForegroundPressed}" />
										<Setter Target="PART_RootGrid.BorderBrush" Value="{ThemeResource PropertiesViewCardBorderBrushPressed}" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Disabled">
									<VisualState.Setters>
										<Setter Target="PART_RootGrid.Background" Value="{ThemeResource PropertiesViewCardBackgroundDisabled}" />
										<Setter Target="PART_HeaderPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForegroundDisabled}" />
										<Setter Target="PART_ActionIconPresenter.Foreground" Value="{ThemeResource PropertiesViewCardHeaderForegroundDisabled}" />
										<Setter Target="PART_ContentPresenter.Foreground" Value="{ThemeResource PropertiesViewCardContentForegroundDisabled}" />
										<Setter Target="PART_RootGrid.BorderBrush" Value="{ThemeResource PropertiesViewCardBorderBrushDisabled}" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentAlignmentStates">
								<!--
									This took a lot of working to get right, because of quirks with
									how the Visual State Triggers failover during evaluation.
									
									Wrapped HAS to be first, with the EqualStateTrigger to catch the
									non default Vertical orientation, so we force that one to always
									use the Wrapped control layout.
									
									|		   | [ header ]							 |
									| [ icon ] | =================================== |
									|		   | [ content ]                         |
									
									
									Then if the first trigger fails, it moves to the next so we
									are now working with the Horizontal orientation, and we use
									the ControlSizeTrigger to handle how we lay out the
									elements based on breakpoints
									
									Left is the default state so we do that after Wrapped
									|				|								 |
									| [ header ]	|	[ content ]					 |
									|				|								 |
									
									
									Right is the middle ground between narrow and wide
									|		   |			|						 |
									| [ icon ] | [ header ]	|		     [ content ] |
									|		   |			|						 |
								-->

								<VisualState x:Name="Wrapped">
									<VisualState.StateTriggers>

										<!--  Vertical ALWAYS Wrapped  -->
										<toolkit:IsEqualStateTrigger Value="{Binding Orientation, RelativeSource={RelativeSource TemplatedParent}}" To="Vertical" />

										<!--  Horizontal small width  -->
										<toolkit:ControlSizeTrigger
											MinWidth="0"
											MaxWidth="{StaticResource PropertiesViewCardWrapThreshold}"
											TargetElement="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.StateTriggers>
									<VisualState.Setters>

										<Setter Target="Col_Label.Width">
											<Setter.Value>
												<GridLength>Auto</GridLength>
											</Setter.Value>
										</Setter>

										<Setter Target="PART_HeaderPresenter.(Grid.Row)" Value="0" />
										<Setter Target="PART_HeaderPresenter.(Grid.RowSpan)" Value="1" />
										<Setter Target="PART_HeaderPresenter.(Grid.Column)" Value="0" />
										<Setter Target="PART_HeaderPresenter.(Grid.ColumnSpan)" Value="3" />

										<Setter Target="PART_ContentPresenter.(Grid.Row)" Value="1" />
										<Setter Target="PART_ContentPresenter.(Grid.RowSpan)" Value="1" />
										<Setter Target="PART_ContentPresenter.(Grid.Column)" Value="0" />
										<Setter Target="PART_ContentPresenter.(Grid.ColumnSpan)" Value="3" />

										<Setter Target="PART_ContentPresenter.HorizontalAlignment" Value="Stretch" />
										<Setter Target="PART_ContentPresenter.HorizontalContentAlignment" Value="{Binding WrappedBreakpointHorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
										<Setter Target="PART_ContentPresenter.VerticalContentAlignment" Value="{Binding WrappedBreakpointVerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.Setters>

								</VisualState>

								<VisualState x:Name="Right">
									<VisualState.StateTriggers>

										<!--  Horizontal large width  -->
										<toolkit:ControlSizeTrigger
											MinWidth="{StaticResource PropertiesViewCardWrapThreshold}"
											MaxWidth="{StaticResource PropertiesViewCardRightThreshold}"
											TargetElement="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.StateTriggers>
									<VisualState.Setters>
										<Setter Target="PART_ContentPresenter.HorizontalAlignment" Value="Stretch" />
										<Setter Target="PART_ContentPresenter.HorizontalContentAlignment" Value="{Binding RightBreakpointHorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
										<Setter Target="PART_ContentPresenter.VerticalContentAlignment" Value="{Binding RightBreakpointVerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.Setters>

								</VisualState>

								<VisualState x:Name="Left">
									<VisualState.StateTriggers>

										<!--  Horizontal medium width  -->
										<toolkit:ControlSizeTrigger MinWidth="{StaticResource PropertiesViewCardRightThreshold}" TargetElement="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
									</VisualState.StateTriggers>
									<VisualState.Setters />

								</VisualState>

							</VisualStateGroup>


							<VisualStateGroup x:Name="OrientationStates">
								<VisualState x:Name="Horizontal">
									<VisualState.Setters>
										<Setter Target="testText.Background" Value="#FF0000" />
									</VisualState.Setters>
								</VisualState>
								<VisualState x:Name="Vertical">
									<VisualState.Setters>
										<Setter Target="testText.Background" Value="#00FF00" />
									</VisualState.Setters>
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentVisibilityStates">
								<VisualState x:Name="Visible" />
								<VisualState x:Name="Collapsed">
									<VisualState.Setters />
								</VisualState>
							</VisualStateGroup>

							<VisualStateGroup x:Name="ContentSpacingStates">
								<VisualState x:Name="NoContentSpacing" />
								<VisualState x:Name="ContentSpacing">
									<VisualState.Setters />
								</VisualState>
							</VisualStateGroup>
						</VisualStateManager.VisualStateGroups>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>



</ResourceDictionary>
