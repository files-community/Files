								<FontIcon
									x:Name="PART_InfoIcon"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="16"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Glyph="&#xEA80;" />

							</Border>
