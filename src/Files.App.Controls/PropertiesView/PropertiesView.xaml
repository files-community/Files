							x:Name="TextGrid"
							Grid.Row="0"
							Grid.RowSpan="2"
							Grid.Column="1"
							Grid.ColumnSpan="1"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center">

							<Grid.ColumnDefinitions>
								<ColumnDefinition x:Name="Col01" Width="Auto" />
								<ColumnDefinition x:Name="Col02" Width="*" />
							</Grid.ColumnDefinitions>

							<TextBlock
								x:Name="PART_Text"
								Grid.Column="0"
								Margin="0,2,12,2"
								VerticalAlignment="Center"
								Text="{TemplateBinding Text}"
