<Page
	x:Class="Files.App.Views.Settings.LayoutTemplatePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.Views.Settings"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:uc="using:Files.App.UserControls"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	mc:Ignorable="d">

	<Grid>
		<StackPanel
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Spacing="4">

			<!--  Title  -->
			<StackPanel
				Padding="0,0,0,12"
				Orientation="Horizontal"
				Spacing="8">
				<HyperlinkButton
					MinWidth="0"
					MinHeight="0"
					Padding="0"
					VerticalAlignment="Top"
					BorderThickness="0"
					Click="LayoutBreadcrumb_Click">
					<TextBlock
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource App.Theme.SubtitleTextBlockStyle}"
						Text="{helpers:ResourceString Name=Layout}" />
				</HyperlinkButton>
				<FontIcon
					VerticalAlignment="Center"
					AutomationProperties.AccessibilityView="Raw"
					FontSize="14"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Glyph="&#xE76C;" />
				<TextBlock
					Style="{StaticResource App.Theme.SubtitleTextBlockStyle}"
					Text="{x:Bind ViewModel.Title, Mode=OneWay}"
					TextTrimming="CharacterEllipsis" />
			</StackPanel>

			<!--  View Layout  -->
			<TextBlock
				Padding="0,16,0,4"
				FontSize="16"
				FontWeight="Medium"
				Text="{helpers:ResourceString Name=ViewLayout}" />

			<ItemsRepeater Margin="0,0,0,8" ItemsSource="{x:Bind ViewModel.LayoutModeChoices}">
				<ItemsRepeater.Layout>
					<UniformGridLayout
						ItemsStretch="Fill"
						MaximumRowsOrColumns="5"
						MinColumnSpacing="4"
						MinItemHeight="68"
						MinItemWidth="112"
						MinRowSpacing="4" />
				</ItemsRepeater.Layout>
				<ItemsRepeater.ItemTemplate>
					<DataTemplate x:DataType="vm:LayoutModeChoice">
						<ToggleButton
							Padding="0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							AutomationProperties.Name="{x:Bind DisplayName}"
							Click="LayoutModeChoice_Click"
							IsChecked="{x:Bind IsSelected, Mode=OneWay}"
							Tag="{x:Bind}">
							<StackPanel Spacing="6">
								<controls:ThemedIcon
									Width="20"
									Height="20"
									HorizontalAlignment="Center"
									IsFilled="{x:Bind IsSelected, Mode=OneWay}"
									Style="{x:Bind local:LayoutTemplatePage.GetIconStyle(IconStyleKey)}" />
								<TextBlock HorizontalAlignment="Center" Text="{x:Bind DisplayName}" />
							</StackPanel>
						</ToggleButton>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>

			<!--  Restore Defaults  -->
			<wctcontrols:SettingsCard
				Command="{x:Bind ViewModel.RestoreDefaultsCommand}"
				Header="{helpers:ResourceString Name=RestoreDefaults}"
				IsActionIconVisible="False"
				IsClickEnabled="True"
				Visibility="{x:Bind ViewModel.IsBuiltIn}">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE777;" />
				</wctcontrols:SettingsCard.HeaderIcon>
			</wctcontrols:SettingsCard>

			<!--  Template Name  -->
			<wctcontrols:SettingsCard
				Description="{x:Bind ViewModel.DisplayName, Mode=OneWay}"
				Header="{helpers:ResourceString Name=TemplateName}"
				Visibility="{x:Bind ViewModel.IsCustom}">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE8AC;" />
				</wctcontrols:SettingsCard.HeaderIcon>
				<Button
					AutomationProperties.Name="{x:Bind ViewModel.RenameName, Mode=OneWay}"
					Command="{x:Bind ViewModel.RenameCommand}"
					Content="{helpers:ResourceString Name=Rename}" />
			</wctcontrols:SettingsCard>

			<!--  Use For File Types  -->
			<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=UseForFileTypes}" Visibility="{x:Bind ViewModel.CanTurnOnFileTypes, Mode=OneWay}">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE8A5;" />
				</wctcontrols:SettingsCard.HeaderIcon>
				<ToggleSwitch AutomationProperties.Name="{helpers:ResourceString Name=UseForFileTypes}" IsOn="{x:Bind ViewModel.IsUsedForFileTypes, Mode=TwoWay}" />
			</wctcontrols:SettingsCard>

			<!--  Use For File Types (On)  -->
			<wctcontrols:SettingsExpander
				Header="{helpers:ResourceString Name=UseForFileTypes}"
				IsExpanded="{x:Bind ViewModel.IsUsedForFileTypes, Mode=OneWay}"
				Visibility="{x:Bind ViewModel.IsUsedForFileTypes, Mode=OneWay}">
				<wctcontrols:SettingsExpander.HeaderIcon>
					<FontIcon Glyph="&#xE8A5;" />
				</wctcontrols:SettingsExpander.HeaderIcon>

				<ToggleSwitch AutomationProperties.Name="{helpers:ResourceString Name=UseForFileTypes}" IsOn="{x:Bind ViewModel.IsUsedForFileTypes, Mode=TwoWay}" />

				<wctcontrols:SettingsExpander.Items>
					<!--  File Extensions  -->
					<wctcontrols:SettingsCard Description="{x:Bind ViewModel.FileTypesSummary, Mode=OneWay}" Header="{helpers:ResourceString Name=FileExtensions}">
						<Button
							AutomationProperties.Name="{helpers:ResourceString Name=EditFileExtensions}"
							Command="{x:Bind ViewModel.EditFileTypesCommand}"
							Content="{helpers:ResourceString Name=Edit}" />
					</wctcontrols:SettingsCard>

					<!--  Threshold  -->
					<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=FileTypesThreshold}">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<NumberBox
								MinWidth="96"
								AutomationProperties.Name="{helpers:ResourceString Name=FileTypesThreshold}"
								Maximum="100"
								Minimum="1"
								SmallChange="10"
								SpinButtonPlacementMode="Inline"
								Value="{x:Bind ViewModel.FileTypesThreshold, Mode=TwoWay}" />
							<TextBlock
								VerticalAlignment="Center"
								AutomationProperties.AccessibilityView="Raw"
								Text="%" />
						</StackPanel>
					</wctcontrols:SettingsCard>
				</wctcontrols:SettingsExpander.Items>
			</wctcontrols:SettingsExpander>

			<!--  Delete Template  -->
			<wctcontrols:SettingsCard
				AutomationProperties.Name="{x:Bind ViewModel.DeleteName, Mode=OneWay}"
				Command="{x:Bind ViewModel.DeleteCommand}"
				Header="{helpers:ResourceString Name=DeleteTemplate}"
				IsActionIconVisible="False"
				IsClickEnabled="True"
				Visibility="{x:Bind ViewModel.IsCustom}">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE74D;" />
				</wctcontrols:SettingsCard.HeaderIcon>
			</wctcontrols:SettingsCard>

			<!--  Columns  -->
			<TextBlock
				Padding="0,16,0,4"
				FontSize="16"
				FontWeight="Medium"
				Text="{helpers:ResourceString Name=Columns}"
				Visibility="{x:Bind ViewModel.IsDetailsLayout, Mode=OneWay}" />

			<!--  Manage Columns  -->
			<wctcontrols:SettingsCard
				Command="{x:Bind ViewModel.ManageColumnsCommand}"
				Header="{helpers:ResourceString Name=ManageColumns}"
				IsClickEnabled="True"
				Visibility="{x:Bind ViewModel.IsDetailsLayout, Mode=OneWay}">
				<wctcontrols:SettingsCard.HeaderIcon>
					<FontIcon Glyph="&#xE71D;" />
				</wctcontrols:SettingsCard.HeaderIcon>
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE70F;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

			<!--  Grouping  -->
			<TextBlock
				Padding="0,16,0,4"
				FontSize="16"
				FontWeight="Medium"
				Text="{helpers:ResourceString Name=Grouping}" />

			<!--  Group By  -->
			<wctcontrols:SettingsCard
				Command="{x:Bind ViewModel.ChooseGroupCommand}"
				Description="{x:Bind ViewModel.GroupChoiceName, Mode=OneWay}"
				Header="{helpers:ResourceString Name=GroupBy}"
				IsClickEnabled="True">
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE70F;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

			<!--  Order Groups  -->
			<wctcontrols:SettingsCard
				Description="{x:Bind ViewModel.GroupDirectionText, Mode=OneWay}"
				Header="{helpers:ResourceString Name=OrderGroups}"
				Visibility="{x:Bind ViewModel.IsGrouped, Mode=OneWay}">
				<wctcontrols:Segmented AutomationProperties.Name="{helpers:ResourceString Name=OrderGroups}" SelectedIndex="{x:Bind ViewModel.SelectedGroupDirectionIndex, Mode=TwoWay}">
					<wctcontrols:SegmentedItem AutomationProperties.Name="{helpers:ResourceString Name=Ascending}" ToolTipService.ToolTip="{helpers:ResourceString Name=Ascending}">
						<wctcontrols:SegmentedItem.Icon>
							<FontIcon Glyph="&#xE74A;" />
						</wctcontrols:SegmentedItem.Icon>
					</wctcontrols:SegmentedItem>
					<wctcontrols:SegmentedItem AutomationProperties.Name="{helpers:ResourceString Name=Descending}" ToolTipService.ToolTip="{helpers:ResourceString Name=Descending}">
						<wctcontrols:SegmentedItem.Icon>
							<FontIcon Glyph="&#xE74B;" />
						</wctcontrols:SegmentedItem.Icon>
					</wctcontrols:SegmentedItem>
				</wctcontrols:Segmented>
			</wctcontrols:SettingsCard>

			<!--  Sorting  -->
			<TextBlock
				Padding="0,16,0,4"
				FontSize="16"
				FontWeight="Medium"
				Text="{helpers:ResourceString Name=Sorting}" />

			<!--  Sort By  -->
			<wctcontrols:SettingsCard
				Command="{x:Bind ViewModel.ChooseSortCommand}"
				Description="{x:Bind ViewModel.SortChoiceName, Mode=OneWay}"
				Header="{helpers:ResourceString Name=SortBy}"
				IsClickEnabled="True">
				<wctcontrols:SettingsCard.ActionIcon>
					<FontIcon Glyph="&#xE70F;" />
				</wctcontrols:SettingsCard.ActionIcon>
			</wctcontrols:SettingsCard>

			<!--  Sort Items  -->
			<wctcontrols:SettingsCard Description="{x:Bind ViewModel.SortDirectionText, Mode=OneWay}" Header="{helpers:ResourceString Name=SortItems}">
				<wctcontrols:Segmented AutomationProperties.Name="{helpers:ResourceString Name=SortItems}" SelectedIndex="{x:Bind ViewModel.SelectedSortDirectionIndex, Mode=TwoWay}">
					<wctcontrols:SegmentedItem AutomationProperties.Name="{helpers:ResourceString Name=Ascending}" ToolTipService.ToolTip="{helpers:ResourceString Name=Ascending}">
						<wctcontrols:SegmentedItem.Icon>
							<FontIcon Glyph="&#xE74A;" />
						</wctcontrols:SegmentedItem.Icon>
					</wctcontrols:SegmentedItem>
					<wctcontrols:SegmentedItem AutomationProperties.Name="{helpers:ResourceString Name=Descending}" ToolTipService.ToolTip="{helpers:ResourceString Name=Descending}">
						<wctcontrols:SegmentedItem.Icon>
							<FontIcon Glyph="&#xE74B;" />
						</wctcontrols:SegmentedItem.Icon>
					</wctcontrols:SegmentedItem>
				</wctcontrols:Segmented>
			</wctcontrols:SettingsCard>

			<!--  Sort Priority  -->
			<wctcontrols:SettingsCard Header="{helpers:ResourceString Name=SortPriority}">
				<uc:ComboBoxEx
					MinWidth="160"
					AutomationProperties.Name="{helpers:ResourceString Name=SortPriority}"
					SelectedIndex="{x:Bind ViewModel.SelectedSortPriorityIndex, Mode=TwoWay}">
					<ComboBoxItem Content="{helpers:ResourceString Name=SortFoldersFirst}" />
					<ComboBoxItem Content="{helpers:ResourceString Name=SortFilesFirst}" />
					<ComboBoxItem Content="{helpers:ResourceString Name=SortFilesAndFoldersTogether}" />
				</uc:ComboBoxEx>
			</wctcontrols:SettingsCard>
		</StackPanel>
	</Grid>
</Page>
