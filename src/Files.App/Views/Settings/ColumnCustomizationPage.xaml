<Page
	x:Class="Files.App.Views.Settings.ColumnCustomizationPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Title bar  -->
		<Grid
			x:Name="WindowTitleBar"
			Height="36"
			Padding="12,0,160,0"
			Background="Transparent">
			<TextBlock
				VerticalAlignment="Center"
				Style="{StaticResource App.Theme.CaptionTextBlockStyle}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
		</Grid>

		<!--  Description  -->
		<TextBlock
			Grid.Row="1"
			Padding="20,4,16,0"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="{x:Bind ViewModel.Description, Mode=OneWay}"
			TextWrapping="WrapWholeWords"
			Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />

		<!--  Columns  -->
		<Grid
			Grid.Row="2"
			Padding="16,12"
			RowSpacing="8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<TextBox
				AutomationProperties.Name="{helpers:ResourceString Name=SearchColumns}"
				PlaceholderText="{helpers:ResourceString Name=SearchColumns}"
				Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

			<Border
				Grid.Row="1"
				Background="{ThemeResource LayerFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="8">
				<ListView
					x:Name="ColumnsList"
					Padding="0,4"
					IsItemClickEnabled="True"
					ItemClick="ColumnsList_ItemClick"
					ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
					KeyDown="ColumnsList_KeyDown"
					SelectionMode="None">
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
							<Setter Property="MinHeight" Value="36" />
							<Setter Property="Padding" Value="8,0" />
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="vm:ColumnPickerItem">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="28" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<!--  Group  -->
								<FontIcon
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									AutomationProperties.AccessibilityView="Raw"
									FontSize="12"
									Glyph="&#xE76C;"
									RenderTransformOrigin="0.5,0.5"
									Visibility="{x:Bind IsGroup}">
									<FontIcon.RenderTransform>
										<RotateTransform Angle="{x:Bind ExpandGlyphAngle, Mode=OneWay}" />
									</FontIcon.RenderTransform>
								</FontIcon>
								<CheckBox
									Grid.Column="1"
									Command="{x:Bind ToggleCommand}"
									IsChecked="{x:Bind IsChecked, Mode=OneWay}"
									IsEnabled="{x:Bind IsEnabled}"
									Visibility="{x:Bind IsGroup}">
									<TextBlock
										FontWeight="SemiBold"
										Text="{x:Bind DisplayName}"
										TextTrimming="CharacterEllipsis" />
								</CheckBox>

								<!--  Column  -->
								<CheckBox
									Grid.Column="1"
									Margin="28,0,0,0"
									Command="{x:Bind ToggleCommand}"
									IsChecked="{x:Bind IsChecked, Mode=OneWay}"
									IsEnabled="{x:Bind IsEnabled}"
									Visibility="{x:Bind IsColumn}">
									<TextBlock
										Text="{x:Bind DisplayName}"
										TextTrimming="CharacterEllipsis"
										ToolTipService.ToolTip="{x:Bind DisplayName}" />
								</CheckBox>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Border>
		</Grid>

		<!--  Actions  -->
		<Grid
			Grid.Row="3"
			Padding="16,12"
			ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Button Command="{x:Bind ViewModel.RestoreDefaultsCommand}" Content="{helpers:ResourceString Name=ResetDefaults}" />
			<StackPanel
				Grid.Column="2"
				Orientation="Horizontal"
				Spacing="8">
				<Button
					MinWidth="96"
					Command="{x:Bind ViewModel.SaveCommand}"
					Content="{helpers:ResourceString Name=Save}"
					Style="{StaticResource AccentButtonStyle}" />
				<Button
					MinWidth="96"
					Command="{x:Bind ViewModel.CancelCommand}"
					Content="{helpers:ResourceString Name=Cancel}" />
			</StackPanel>
		</Grid>
	</Grid>
</Page>
