<Page
	x:Class="Files.App.Views.Settings.ColumnCustomizationPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	mc:Ignorable="d">

	<Page.Resources>
		<Style
			x:Key="HeaderTextStyle"
			BasedOn="{StaticResource App.Theme.CaptionTextBlockStyle}"
			TargetType="TextBlock">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
			<Setter Property="TextWrapping" Value="NoWrap" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Title bar  -->
		<Grid
			x:Name="WindowTitleBar"
			Height="36"
			Padding="12,0,160,0"
			Background="Transparent">
			<TextBlock
				VerticalAlignment="Center"
				Style="{StaticResource App.Theme.CaptionTextBlockStyle}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
		</Grid>

		<!--  Description  -->
		<TextBlock
			Grid.Row="1"
			Padding="20,4,16,0"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="{x:Bind ViewModel.Description, Mode=OneWay}"
			TextWrapping="WrapWholeWords"
			Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />

		<!--  Available and Shown columns  -->
		<Grid
			Grid.Row="2"
			Padding="16,12"
			ColumnSpacing="12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="260" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<TextBlock
				Margin="4,0,0,8"
				Style="{StaticResource HeaderTextStyle}"
				Text="{helpers:ResourceString Name=AvailableColumns}" />
			<TextBlock
				Grid.Column="1"
				Margin="4,0,0,8"
				Style="{StaticResource HeaderTextStyle}"
				Text="{helpers:ResourceString Name=ShownColumns}" />

			<!--  Available columns  -->
			<Grid
				Grid.Row="1"
				Grid.Column="0"
				RowSpacing="8">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBox
					AutomationProperties.Name="{helpers:ResourceString Name=SearchColumns}"
					PlaceholderText="{helpers:ResourceString Name=SearchColumns}"
					Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
				<Border
					Grid.Row="1"
					Background="{ThemeResource LayerFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="8">
					<ScrollViewer
						Padding="0,4,0,4"
						HorizontalScrollBarVisibility="Auto"
						HorizontalScrollMode="Enabled"
						VerticalScrollBarVisibility="Auto"
						VerticalScrollMode="Enabled">
						<TreeView
							x:Name="AvailableColumnsTree"
							AllowDrop="False"
							CanDragItems="True"
							CanReorderItems="False"
							DragItemsCompleted="AvailableColumnsTree_DragItemsCompleted"
							DragItemsStarting="AvailableColumnsTree_DragItemsStarting"
							ItemInvoked="AvailableColumnsTree_ItemInvoked"
							ItemsSource="{x:Bind ViewModel.AvailableColumnGroups, Mode=OneWay}"
							SelectionMode="Single">
							<TreeView.ItemContainerStyle>
								<Style TargetType="TreeViewItem">
									<Setter Property="Padding" Value="0,0,8,0" />
								</Style>
							</TreeView.ItemContainerStyle>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="vm:ColumnTreeItem">
									<TreeViewItem
										DoubleTapped="AvailableColumn_DoubleTapped"
										IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
										ItemsSource="{x:Bind Children}">
										<TextBlock VerticalAlignment="Center" Text="{x:Bind DisplayName}" />
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</ScrollViewer>
				</Border>
			</Grid>

			<!--  Shown columns  -->
			<Border
				Grid.Row="1"
				Grid.Column="1"
				Background="{ThemeResource LayerFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="8">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<ListView
						x:Name="ShownColumnsList"
						Grid.Row="1"
						Padding="4"
						AllowDrop="True"
						CanDragItems="True"
						CanReorderItems="True"
						DragItemsCompleted="ShownColumnsList_DragItemsCompleted"
						DragItemsStarting="ShownColumnsList_DragItemsStarting"
						DragOver="ShownColumnsList_DragOver"
						Drop="ShownColumnsList_Drop"
						ItemsSource="{x:Bind ViewModel.ShownColumns, Mode=OneWay}"
						KeyDown="ShownColumnsList_KeyDown"
						ReorderMode="Enabled"
						SelectionMode="None">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="vm:ColumnListItem">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="48" />
									</Grid.ColumnDefinitions>
									<PathIcon
										Margin="4,0,0,0"
										HorizontalAlignment="Left"
										VerticalAlignment="Center"
										Data="{StaticResource App.Theme.PathIcon.DragGripper}"
										Visibility="{x:Bind IsMovable}" />
									<TextBlock
										Margin="24,0,8,0"
										VerticalAlignment="Center"
										Text="{x:Bind DisplayName}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap"
										ToolTipService.ToolTip="{x:Bind DisplayName}" />
									<Button
										Grid.Column="1"
										Width="32"
										Height="24"
										Padding="0"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										AutomationProperties.Name="{helpers:ResourceString Name=Remove}"
										Background="Transparent"
										BorderThickness="0"
										Click="RemoveColumn_Click"
										ToolTipService.ToolTip="{helpers:ResourceString Name=Remove}"
										Visibility="{x:Bind IsMovable}">
										<Button.Resources>
											<SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemFillColorCritical}" />
											<SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
										</Button.Resources>
										<FontIcon FontSize="12" Glyph="&#xE711;" />
									</Button>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
						<ListView.ItemContainerStyle>
							<Style TargetType="ListViewItem">
								<Setter Property="Margin" Value="0" />
								<Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
								<Setter Property="BorderThickness" Value="0,0,0,1" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="MinHeight" Value="40" />
								<Setter Property="HorizontalAlignment" Value="Stretch" />
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListView.ItemContainerStyle>
					</ListView>
				</Grid>
			</Border>
		</Grid>

		<!--  Actions  -->
		<Grid
			Grid.Row="3"
			Padding="16,12"
			ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Button Click="RestoreDefaults_Click" Content="{helpers:ResourceString Name=RestoreDefaults}" />
			<StackPanel
				Grid.Column="2"
				Orientation="Horizontal"
				Spacing="8">
				<Button
					MinWidth="96"
					Click="Save_Click"
					Content="{helpers:ResourceString Name=Save}"
					Style="{StaticResource AccentButtonStyle}" />
				<Button
					MinWidth="96"
					Click="Cancel_Click"
					Content="{helpers:ResourceString Name=Cancel}" />
			</StackPanel>
		</Grid>
	</Grid>
</Page>
