<Page
	x:Class="Files.App.Views.Settings.LayoutPropertyPickerPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:Files.App.ViewModels.Settings"
	mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Title bar  -->
		<Grid
			x:Name="WindowTitleBar"
			Height="36"
			Padding="12,0,160,0"
			Background="Transparent">
			<TextBlock
				VerticalAlignment="Center"
				Style="{StaticResource App.Theme.CaptionTextBlockStyle}"
				Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
		</Grid>

		<!--  Description  -->
		<TextBlock
			Grid.Row="1"
			Padding="20,4,16,0"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="{x:Bind ViewModel.Description, Mode=OneWay}"
			TextWrapping="WrapWholeWords" />

		<!--  Search  -->
		<TextBox
			Grid.Row="2"
			Margin="16,12,16,0"
			AutomationProperties.Name="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
			PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}"
			Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

		<!--  Choices  -->
		<Border
			Grid.Row="3"
			Margin="16,12,16,0"
			Background="{ThemeResource LayerFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="8">
			<ListView
				x:Name="ChoicesList"
				Padding="0,4"
				IsItemClickEnabled="True"
				ItemClick="ChoicesList_ItemClick"
				ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
				KeyDown="ChoicesList_KeyDown"
				Loaded="ChoicesList_Loaded"
				SelectionMode="None">
				<ListView.ItemContainerStyle>
					<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
						<Setter Property="MinHeight" Value="36" />
						<Setter Property="Padding" Value="8,0" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="vm:LayoutPropertyPickerItem">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="28" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  Group  -->
							<FontIcon
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								AutomationProperties.AccessibilityView="Raw"
								FontSize="12"
								Glyph="&#xE76C;"
								RenderTransformOrigin="0.5,0.5"
								Visibility="{x:Bind IsGroup}">
								<FontIcon.RenderTransform>
									<RotateTransform Angle="{x:Bind ExpandGlyphAngle, Mode=OneWay}" />
								</FontIcon.RenderTransform>
							</FontIcon>
							<TextBlock
								Grid.Column="1"
								VerticalAlignment="Center"
								FontWeight="SemiBold"
								Text="{x:Bind DisplayName}"
								TextTrimming="CharacterEllipsis"
								Visibility="{x:Bind IsGroup}" />

							<!--  Choice  -->
							<RadioButton
								Grid.Column="1"
								AutomationProperties.AccessibilityView="Raw"
								IsChecked="{x:Bind IsSelected, Mode=OneWay}"
								IsHitTestVisible="False"
								IsTabStop="False"
								Visibility="{x:Bind IsChoice}">
								<TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" />
							</RadioButton>
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</Border>

		<!--  Actions  -->
		<StackPanel
			Grid.Row="4"
			Padding="16,12"
			HorizontalAlignment="Right"
			Orientation="Horizontal"
			Spacing="8">
			<Button
				MinWidth="96"
				Command="{x:Bind ViewModel.SelectCommand}"
				Content="{helpers:ResourceString Name=Select}"
				Style="{StaticResource AccentButtonStyle}" />
			<Button
				MinWidth="96"
				Command="{x:Bind ViewModel.CancelCommand}"
				Content="{helpers:ResourceString Name=Cancel}" />
		</StackPanel>
	</Grid>
</Page>
