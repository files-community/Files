<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="Files.App.UserControls.FilePreviews.ShellPreview"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.UserControls.FilePreviews"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	PointerEntered="PreviewHost_PointerEntered"
	PointerExited="PreviewHost_PointerExited"
	Unloaded="PreviewHost_Unloaded"
	mc:Ignorable="d">

	<Grid>
		<ContentPresenter
			Name="contentPresenter"
			Background="Transparent"
			Loaded="PreviewHost_Loaded"
			SizeChanged="PreviewHost_SizeChanged" />
		<StackPanel
			x:Name="PreviewError"
			Margin="12"
			VerticalAlignment="Center"
			Spacing="8"
			Visibility="Collapsed">
			<TextBlock
				Style="{ThemeResource BodyStrongTextBlockStyle}"
				Text="{x:Bind ViewModel.PreviewHandlerName}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<TextBlock
				Text="{helpers:ResourceString Name=DetailsPanePreviewNotAvaliableText}"
				TextAlignment="Center"
				TextWrapping="WrapWholeWords" />
		</StackPanel>
		<ProgressRing
			x:Name="LoadingIndicator"
			AutomationProperties.Name="{helpers:ResourceString Name=Loading}"
			IsActive="True"
			IsIndeterminate="True" />
	</Grid>
</UserControl>
