<Page
	x:Class="Files.App.UITests.Dialogs.PropertiesGeneralPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Files.App.UITests.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Page.Resources>
		<ResourceDictionary>
			<GridLength x:Key="PropertiesGeneralLabelWidth">148</GridLength>
			<Style BasedOn="{StaticResource DefaultPropertiesViewCardStyle}" TargetType="controls:PropertiesViewCard">
				<Setter Property="LabelWidth" Value="{StaticResource PropertiesGeneralLabelWidth}" />
				<Setter Property="VerticalAlignment" Value="Center" />
			</Style>
		</ResourceDictionary>
	</Page.Resources>

	<controls:PropertiesView>
		<controls:PropertiesView.Header>
			<Grid Padding="24,20">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="{StaticResource PropertiesGeneralLabelWidth}" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border
					Width="72"
					Height="72"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="{ThemeResource OverlayCornerRadius}">
					<Rectangle
						Width="48"
						Height="48"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Fill="Red" />
				</Border>

				<StackPanel
					Grid.Column="1"
					VerticalAlignment="Center"
					Spacing="8">
					<TextBox Margin="-12,0,0,0" Text="Filename here" />
					<TextBlock Text="Sticky header area with scrolling below" />
				</StackPanel>
			</Grid>
		</controls:PropertiesView.Header>

		<controls:PropertiesViewExpander Header="General" IsExpanded="True">
			<controls:PropertiesViewExpander.HeaderIcon>
				<SymbolIcon Symbol="Document" />
			</controls:PropertiesViewExpander.HeaderIcon>
			<StackPanel Padding="0,0,0,8" HorizontalAlignment="Stretch">
				<controls:PropertiesViewCard Header="Name">
					<TextBox
						Margin="{ThemeResource PropertiesValueTextBoxMargin}"
						HorizontalAlignment="Stretch"
						Text="Filename here" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard Header="Type">
					<TextBlock
						VerticalAlignment="Center"
						Text="Text Document (.txt)"
						TextWrapping="WrapWholeWords" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard Header="Additional information">
					<Grid ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock VerticalAlignment="Center" Text="Information value" />
						<Button
							Grid.Column="1"
							AutomationProperties.Name="Show additional information"
							ToolTipService.ToolTip="Detailed text displayed on hover"
							Visibility="Collapsed">
							<FontIcon Glyph="&#xEA80;" />
						</Button>
						<controls:PropertiesViewInfo
							Grid.Column="1"
							AutomationProperties.Name="Show additional information"
							ToolTipService.ToolTip="Detailed text displayed on hover" />
						<controls:PropertiesViewInfo
							Grid.Column="2"
							AutomationProperties.Name="Show additional information"
							IsEnabled="False"
							ToolTipService.ToolTip="Detailed text displayed on hover" />
					</Grid>
				</controls:PropertiesViewCard>

				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard Header="Disabled card" IsEnabled="False">
					<TextBlock Text="Disabled value" />
				</controls:PropertiesViewCard>

				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard
					AutomationProperties.AutomationId="ClickablePropertiesViewCard"
					Header="Clickable card (no content)"
					IsClickEnabled="True"
					LabelWidth="Auto" />

				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard
					Header="Disabled clickable card (no content)"
					IsClickEnabled="True"
					IsEnabled="False"
					LabelWidth="Auto" />
				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard
					AutomationProperties.AutomationId="ClickablePropertiesViewCard"
					Content="Content doesn't look so good in clickable cards"
					FontSize="{ThemeResource BodyTextBlockFontSize}"
					FontWeight="Semibold"
					Header="Clickable card"
					IsClickEnabled="True"
					LabelWidth="Auto" />

				<controls:PropertiesViewItemSeparator />

				<controls:PropertiesViewCard
					Content="Content doesn't look so good in clickable cards"
					FontSize="{ThemeResource BodyTextBlockFontSize}"
					FontWeight="Semibold"
					Header="Disabled clickable card"
					IsClickEnabled="True"
					IsEnabled="False"
					LabelWidth="Auto" />
			</StackPanel>
		</controls:PropertiesViewExpander>

		<controls:PropertiesViewExpander Header="Ratings">
			<controls:PropertiesViewExpander.HeaderIcon>
				<SymbolIcon Symbol="Favorite" />
			</controls:PropertiesViewExpander.HeaderIcon>
			<StackPanel Padding="0,0,0,8" HorizontalAlignment="Stretch">
				<controls:PropertiesViewCard Header="Read-only rating">
					<RatingControl IsReadOnly="True" Value="4" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard Header="Editable rating">
					<RatingControl Value="3" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard Header="Disabled rating" IsEnabled="False">
					<RatingControl Value="2" />
				</controls:PropertiesViewCard>
			</StackPanel>
		</controls:PropertiesViewExpander>

		<controls:PropertiesViewExpander Header="Vertical examples" IsExpanded="True">
			<controls:PropertiesViewExpander.HeaderIcon>
				<SymbolIcon Symbol="SlideShow" />
			</controls:PropertiesViewExpander.HeaderIcon>
			<StackPanel Padding="0,0,0,8" HorizontalAlignment="Stretch">
				<controls:PropertiesViewCard Header="Editable vertical value" Orientation="Vertical">
					<TextBox
						Margin="{ThemeResource PropertiesValueTextBoxMargin}"
						HorizontalAlignment="Stretch"
						Text="Item value text" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard Header="A long header that demonstrates wrapping when the available width becomes constrained" Orientation="Vertical">
					<TextBlock Text="A long value that also wraps across multiple lines when the properties window becomes narrow." TextWrapping="Wrap" />
				</controls:PropertiesViewCard>
			</StackPanel>
		</controls:PropertiesViewExpander>

		<controls:PropertiesViewExpander Header="Toggle items">
			<controls:PropertiesViewExpander.HeaderIcon>
				<SymbolIcon Symbol="XboxOneConsole" />
			</controls:PropertiesViewExpander.HeaderIcon>
			<StackPanel Padding="0,0,0,8" HorizontalAlignment="Stretch">
				<controls:PropertiesViewCard Header="Enabled and on">
					<ToggleSwitch IsOn="True" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard Header="Enabled and off">
					<ToggleSwitch IsOn="False" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard Header="Disabled and on" IsEnabled="False">
					<ToggleSwitch IsOn="True" />
				</controls:PropertiesViewCard>
			</StackPanel>
		</controls:PropertiesViewExpander>

		<controls:PropertiesViewExpander Header="Check box items">
			<controls:PropertiesViewExpander.HeaderIcon>
				<SymbolIcon Symbol="Accept" />
			</controls:PropertiesViewExpander.HeaderIcon>
			<StackPanel Padding="0,0,0,8" HorizontalAlignment="Stretch">
				<controls:PropertiesViewCard>
					<CheckBox Content="Unchecked option" IsChecked="False" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard>
					<CheckBox Content="Checked option" IsChecked="True" />
				</controls:PropertiesViewCard>
				<controls:PropertiesViewItemSeparator />
				<controls:PropertiesViewCard>
					<CheckBox
						Content="Indeterminate option"
						IsChecked="{x:Null}"
						IsThreeState="True" />
				</controls:PropertiesViewCard>
			</StackPanel>
		</controls:PropertiesViewExpander>
	</controls:PropertiesView>

</Page>
