<Page
	x:Class="Files.App.UITests.Dialogs.PropertiesDetailsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Files.App.UITests.Dialogs"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">
	<Page.Resources>

		<GridLength x:Key="PropertiesDetailsLabelWidth">200</GridLength>
		<Style BasedOn="{StaticResource DefaultPropertiesViewCardStyle}" TargetType="controls:PropertiesViewCard">
			<Setter Property="LabelWidth" Value="{StaticResource PropertiesDetailsLabelWidth}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

	</Page.Resources>

	<controls:PropertiesView>

		<controls:PropertiesViewExpander Header="Description" IsExpanded="True">
			<controls:PropertiesViewExpander.HeaderIcon>
				<FontIcon Glyph="&#xF0E3;" />
			</controls:PropertiesViewExpander.HeaderIcon>
			<StackPanel Padding="0,0,0,8" HorizontalAlignment="Stretch">
				<controls:PropertiesViewCard Header="Description" Orientation="Vertical">
					<TextBox
						MinHeight="96"
						Margin="-12,0"
						Padding="24,4"
						AcceptsReturn="True"
						Text="Add a description for this file."
						TextWrapping="Wrap" />
				</controls:PropertiesViewCard>
			</StackPanel>
		</controls:PropertiesViewExpander>

	</controls:PropertiesView>
</Page>
