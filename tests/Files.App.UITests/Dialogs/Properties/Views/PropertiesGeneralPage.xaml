<Page
	x:Class="Files.App.UITests.Dialogs.Properties.Views.PropertiesGeneralPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dcontrols="using:Files.App.Controls.Dialogs"
	xmlns:dialogs="using:Files.App.UITests.Dialogs"
	xmlns:fcontrols="using:Files.App.Controls"
	xmlns:local="using:Files.App.UITests.Dialogs.Properties.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>

				<ResourceDictionary Source="ms-appx:///Files.App.Controls/Dialogs/DialogResources.xaml" />

			</ResourceDictionary.MergedDictionaries>

			<GridLength x:Key="LabelWidth">120</GridLength>

		</ResourceDictionary>
	</Page.Resources>



	<Grid
		x:Name="RootGrid"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border
			x:Name="GeneralHeader"
			Grid.Row="0"
			Padding="24,20"
			VerticalAlignment="Stretch"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="{StaticResource LabelWidth}" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border
					Width="72"
					Height="72"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="{ThemeResource OverlayCornerRadius}">
					<Rectangle
						Width="48"
						Height="48"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Fill="Red" />
				</Border>

				<StackPanel
					Grid.Column="1"
					VerticalAlignment="Center"
					Orientation="Vertical"
					Spacing="8">
					<TextBox Text="Filename here" Margin="-12,0,0,0" />
					<TextBlock Text="Sticky header area with scrolling below" />
				</StackPanel>

			</Grid>

		</Border>


		<ScrollViewer
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">

			<StackPanel
				Margin="0,0,0,32"
				HorizontalAlignment="Stretch"
				Orientation="Vertical">
				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<dcontrols:PropertiesHeader Text="Header text goes here">
							<dcontrols:PropertiesHeader.Icon>
								<SymbolIcon Symbol="AddFriend" />
							</dcontrols:PropertiesHeader.Icon>
						</dcontrols:PropertiesHeader>
					</Expander.Header>

					<Expander.Content>
						<StackPanel
							HorizontalAlignment="Stretch"
							Background="#11FF0000"
							Orientation="Vertical">
							<TextBlock Height="48" Text="Item 1 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 2 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 3 in the stack" />
						</StackPanel>
					</Expander.Content>
				</Expander>


				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<dcontrols:PropertiesHeader Text="Header text goes here, made extra long to ensure wrapping and arranging within the header works as expected">
							<dcontrols:PropertiesHeader.Icon>
								<SymbolIcon Symbol="Comment" />
							</dcontrols:PropertiesHeader.Icon>
						</dcontrols:PropertiesHeader>
					</Expander.Header>

					<Expander.Content>
						<StackPanel
							HorizontalAlignment="Stretch"
							Background="#1100FF00"
							Orientation="Vertical">
							<TextBlock Height="48" Text="Item 1 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 2 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 3 in the stack" />
						</StackPanel>
					</Expander.Content>
				</Expander>





				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<dcontrols:PropertiesHeader Text="Header text goes here">
							<dcontrols:PropertiesHeader.Icon>
								<SymbolIcon Symbol="SlideShow" />
							</dcontrols:PropertiesHeader.Icon>
						</dcontrols:PropertiesHeader>
					</Expander.Header>

					<Expander.Content>
						<StackPanel
							HorizontalAlignment="Stretch"
							Background="#110000FF"
							Orientation="Vertical">
							<TextBlock Height="48" Text="Item 1 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 2 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 3 in the stack" />
						</StackPanel>
					</Expander.Content>
				</Expander>

				<Grid
					Padding="24,6"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{StaticResource LabelWidth}" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock
						x:Name="Label"
						Grid.RowSpan="2"
						Grid.Column="0"
						Margin="0,2,12,2"
						VerticalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{ThemeResource CaptionTextBlockStyle}"
						Text="Label Text" />
					<TextBlock
						x:Name="Value"
						Grid.RowSpan="2"
						Grid.Column="1"
						Margin="0,2,12,2"
						VerticalAlignment="Bottom"
						Text="This is the value text  that is very very long so it wraps at the width set"
						TextWrapping="WrapWholeWords" />
				</Grid>


				<MenuFlyoutSeparator Margin="24,0" />

				<Grid
					Padding="24,6"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Center">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="{StaticResource LabelWidth}" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock
						x:Name="Label2"
						Grid.Row="0"
						Grid.RowSpan="1"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Margin="0,2,12,2"
						VerticalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{ThemeResource CaptionTextBlockStyle}"
						Text="Label Text" />
					<TextBlock
						x:Name="Value2"
						Grid.Row="1"
						Grid.RowSpan="1"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Margin="0,2,12,2"
						VerticalAlignment="Bottom"
						Text="This is the value text  that is very very long so it wraps at the width set"
						TextWrapping="WrapWholeWords" />
				</Grid>

			</StackPanel>
		</ScrollViewer>

	</Grid>

</Page>
