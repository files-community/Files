<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="Files.App.UITests.Dialogs.Properties.Views.PropertiesGeneralPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fcontrols="using:Files.App.Controls"
	xmlns:local="using:Files.App.UITests.Dialogs.Properties.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary Source="ms-appx:///Files.App.Controls/Dialogs/DialogResources.xaml" />
	</Page.Resources>




	<ScrollViewer>

		<Grid Margin="0,0,0,24">

			<StackPanel Padding="0,0,0,0" Orientation="Vertical">

				<Expander
					Margin="24,0,24,24"
					Header="Expander title"
					IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}">
					Expander content goes here.
				</Expander>

				<Rectangle Height="4" Fill="Red" />

				<Expander
					Margin="24,0,24,24"
					Background="DarkGoldenrod"
					BorderBrush="Green"
					BorderThickness="10"
					IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}">

					<Expander.Header>
						<TextBlock Text="Expander title, made extra long to test how it may wrap when there is not enough space to display it on a single line." TextWrapping="WrapWholeWords" />
					</Expander.Header>
					<Expander.Content>
						<TextBlock Text="Expander content goes here." />
					</Expander.Content>
				</Expander>

				<Rectangle Height="4" Fill="Red" />

				<ToggleButton IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}" Style="{StaticResource PropertiesExpanderHeaderDownStyle}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<SymbolIcon Symbol="Calendar" />
						<TextBlock Text="Expander heading text" />
					</StackPanel>
				</ToggleButton>

				<Border
					x:Name="PropertiesSeparator"
					Height="4"
					Margin="0,0,0,0"
					HorizontalAlignment="Stretch">
					<Rectangle
						Height="1"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
				</Border>

				<ToggleButton IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}" Style="{StaticResource PropertiesExpanderHeaderUpStyle}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<SymbolIcon Symbol="Calendar" />
						<TextBlock Text="Expander heading text" />
					</StackPanel>
				</ToggleButton>

				<Rectangle Height="4" Fill="Red" />

				<ToggleButton
					Background="DarkOrange"
					BorderBrush="DarkSeaGreen"
					BorderThickness="4"
					IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}"
					Style="{StaticResource PropertiesExpanderHeaderDownStyle}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<SymbolIcon Symbol="Calendar" />
						<TextBlock Text="Expander heading text" />
					</StackPanel>
				</ToggleButton>

				<Border
					Height="4"
					Margin="0,0,0,0"
					HorizontalAlignment="Stretch">
					<Rectangle
						Height="1"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
				</Border>

				<ToggleButton
					Background="DarkOliveGreen"
					BorderBrush="DarkMagenta"
					BorderThickness="4"
					IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}"
					Style="{StaticResource PropertiesExpanderHeaderUpStyle}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<SymbolIcon Symbol="Calendar" />
						<TextBlock Text="Expander heading text" />
					</StackPanel>
				</ToggleButton>

				<Rectangle Height="4" Fill="Red" />

				<ToggleSwitch
					x:Name="EnableToggle"
					Header="Enable ToggleButton"
					IsOn="True"
					OffContent="Disabled"
					OnContent="Enabled" />

				<Rectangle Height="4" Fill="Red" />

				<Expander
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					Background="#213243"
					BorderBrush="HotPink"
					BorderThickness="1"
					IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}"
					Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Content>
						<StackPanel
							HorizontalAlignment="Stretch"
							Background="DarkBlue"
							Orientation="Vertical">
							<TextBlock Text="Customised expander content." />
						</StackPanel>
					</Expander.Content>
					<Expander.Header>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<SymbolIcon
								Grid.Column="0"
								Margin="0,0,12,0"
								Symbol="Calendar" />
							<TextBlock
								Grid.Column="1"
								Margin="0,4"
								HorizontalAlignment="Left"
								Text="Custom expander heading text, made extra long to test how it may wrap when there is not enough space to display it on a single line."
								TextWrapping="WrapWholeWords" />
						</Grid>
					</Expander.Header>
				</Expander>



				<Border
					Height="4"
					Margin="0,0,0,0"
					HorizontalAlignment="Stretch">
					<Rectangle
						Height="1"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
				</Border>

				<Expander
					HorizontalAlignment="Stretch"
					HorizontalContentAlignment="Stretch"
					IsEnabled="{x:Bind EnableToggle.IsOn, Mode=TwoWay}"
					Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Content>
						<StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
							<TextBlock Text="Customised expander content." />
						</StackPanel>
					</Expander.Content>
					<Expander.Header>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<SymbolIcon
								Grid.Column="0"
								Margin="0,0,12,0"
								Symbol="Calendar" />
							<TextBlock
								Grid.Column="1"
								Margin="0,4"
								HorizontalAlignment="Left"
								Text="Custom expander heading text."
								TextWrapping="WrapWholeWords" />
						</Grid>
					</Expander.Header>
				</Expander>



				<Border
					Height="4"
					Margin="0,0,0,0"
					HorizontalAlignment="Stretch">
					<Rectangle
						Height="1"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
				</Border>

			</StackPanel>

		</Grid>

	</ScrollViewer>

</Page>
