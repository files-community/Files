<Page
	x:Class="Files.App.UITests.Dialogs.Properties.Views.PropertiesGeneralPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fcontrols="using:Files.App.Controls"
	xmlns:local="using:Files.App.UITests.Dialogs.Properties.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries />

			<GridLength x:Key="LabelWidth">80</GridLength>

		</ResourceDictionary>
	</Page.Resources>



	<Grid
		x:Name="RootGrid"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border
			x:Name="GeneralHeader"
			Grid.Row="0"
			Padding="24,20"
			VerticalAlignment="Stretch"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1">

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="{StaticResource LabelWidth}" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border
					Width="72"
					Height="72"
					HorizontalAlignment="Left"
					VerticalAlignment="Center"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
					BorderThickness="1"
					CornerRadius="{ThemeResource OverlayCornerRadius}">
					<Rectangle
						Width="48"
						Height="48"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Fill="Red" />
				</Border>

				<StackPanel
					Grid.Column="1"
					VerticalAlignment="Center"
					Orientation="Vertical"
					Spacing="8">
					<TextBox Margin="-12,0,0,0" Text="Filename here" />
					<TextBlock Text="Sticky header area with scrolling below" />
				</StackPanel>

			</Grid>

		</Border>


		<ScrollViewer
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">

			<StackPanel
				Margin="0,0,0,32"
				HorizontalAlignment="Stretch"
				Orientation="Vertical">
				<Expander IsExpanded="True" Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<fcontrols:PropertiesHeader Text="Header text goes here">
							<fcontrols:PropertiesHeader.Icon>
								<SymbolIcon Symbol="AddFriend" />
							</fcontrols:PropertiesHeader.Icon>
						</fcontrols:PropertiesHeader>
					</Expander.Header>

					<Expander.Content>

						<StackPanel
							Padding="0,0,0,8"
							HorizontalAlignment="Stretch"
							Orientation="Vertical">
							<fcontrols:PropertiesViewItemText
								CanEdit="True"
								Label="Item label 1"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Horizontal"
								Text="Item value 1 text here" />
							<MenuFlyoutSeparator />
							<fcontrols:PropertiesViewItemInfo
								CanEdit="False"
								InfoText="Detailed text to display with the button press."
								Label="Item info label 1"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Horizontal"
								Text="Info item value 1 text" />
							<MenuFlyoutSeparator />
							<fcontrols:PropertiesViewItemInfo
								CanEdit="True"
								InfoText="Detailed text to display with the button press."
								Label="Item info label 1"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Horizontal"
								Text="Info item value 1 text" />
							<MenuFlyoutSeparator />
							<fcontrols:PropertiesViewItemText
								Label="Item label t00 extra long to demonstrate the wrapping for Labels"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Horizontal"
								Text="Item value t00 text here" />
							<MenuFlyoutSeparator />
							<fcontrols:PropertiesViewItemText
								Label="Item label three"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Horizontal"
								Text="Item value three text here, extra long to show how text values will wrap onto mnany lines." />
						</StackPanel>
					</Expander.Content>
				</Expander>


				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<fcontrols:PropertiesHeader Text="Header text goes here, made extra long to ensure wrapping and arranging within the header works as expected">
							<fcontrols:PropertiesHeader.Icon>
								<SymbolIcon Symbol="Comment" />
							</fcontrols:PropertiesHeader.Icon>
						</fcontrols:PropertiesHeader>
					</Expander.Header>

					<Expander.Content>
						<StackPanel
							Padding="0,0,0,8"
							HorizontalAlignment="Stretch"
							Orientation="Vertical">
							<fcontrols:PropertiesViewItemRating
								Label="Item label 1 readonly"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Horizontal"
								Rating="9345" />
							<MenuFlyoutSeparator Margin="16,0" />
							<fcontrols:PropertiesViewItemRating
								CanEdit="True"
								Label="Item label t00 editable"
								Orientation="Horizontal"
								Rating="-23" />
							<MenuFlyoutSeparator Margin="16,0" />
							<fcontrols:PropertiesViewItemRating
								CanEdit="False"
								Label="Item label three readonly"
								Orientation="Horizontal"
								Rating="32" />
							<MenuFlyoutSeparator Margin="16,0" />
							<fcontrols:PropertiesViewItemRating
								CanEdit="True"
								Label="Item label 4ore editable"
								Orientation="Horizontal"
								Rating="72" />
						</StackPanel>
					</Expander.Content>
				</Expander>





				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<fcontrols:PropertiesHeader Text="Vertical examples">
							<fcontrols:PropertiesHeader.Icon>
								<SymbolIcon Symbol="SlideShow" />
							</fcontrols:PropertiesHeader.Icon>
						</fcontrols:PropertiesHeader>
					</Expander.Header>

					<Expander.Content>
						<StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">

							<fcontrols:PropertiesViewItemText
								CanEdit="True"
								Label="Item label 1"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Vertical"
								Text="Item value 1 text here" />

							<MenuFlyoutSeparator />

							<fcontrols:PropertiesViewItemInfo
								CanEdit="False"
								InfoText="Detailed text to display with the button press."
								Label="Item info label 1"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Vertical"
								Text="Info item value 1 text" />

							<MenuFlyoutSeparator />

							<fcontrols:PropertiesViewItemInfo
								CanEdit="True"
								InfoText="Detailed text to display with the button press."
								Label="Item info label 1"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Vertical"
								Text="Info item value 1 text" />

							<MenuFlyoutSeparator />

							<fcontrols:PropertiesViewItemRating
								CanEdit="True"
								Label="Really long label wrapping when using a vertical layout example here for your viewing pleasure."
								Orientation="Vertical"
								Rating="54" />

							<MenuFlyoutSeparator />

							<fcontrols:PropertiesViewItemText
								CanEdit="False"
								Label="Item label three"
								LabelWidth="{StaticResource LabelWidth}"
								Orientation="Vertical"
								Text="Item value 1 text here, made long so we can see how wrapping will work for this vertical exanple of the control layout. " />
						</StackPanel>
					</Expander.Content>
				</Expander>


			</StackPanel>
		</ScrollViewer>

	</Grid>

</Page>
