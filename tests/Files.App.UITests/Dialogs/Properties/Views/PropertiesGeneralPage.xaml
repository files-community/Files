<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="Files.App.UITests.Dialogs.Properties.Views.PropertiesGeneralPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
	xmlns:controls="using:Microsoft.UI.Xaml.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:fcontrols="using:Files.App.Controls"
	xmlns:local="using:Files.App.UITests.Dialogs.Properties.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d">

	<Page.Resources>
		<ResourceDictionary Source="ms-appx:///Files.App.Controls/Dialogs/DialogResources.xaml" />
	</Page.Resources>



	<Grid
		x:Name="RootGrid"
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch">
		<Grid.RowDefinitions>
			<RowDefinition Height="128" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<Border
			x:Name="GeneralHeader"
			Grid.Row="0"
			Padding="24,16"
			VerticalAlignment="Stretch"
			BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
			BorderThickness="0,0,0,1">

			<TextBlock Text="Sticky header area with scrolling below" />

		</Border>


		<ScrollViewer
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">

			<StackPanel
				Margin="0,0,0,32"
				HorizontalAlignment="Stretch"
				Orientation="Vertical">
				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<TextBlock Text="Header goes here" />
					</Expander.Header>

					<Expander.Content>
						<StackPanel
							HorizontalAlignment="Stretch"
							Background="#11FF0000"
							Orientation="Vertical">
							<TextBlock Height="48" Text="Item 1 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 2 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 3 in the stack" />
						</StackPanel>
					</Expander.Content>
				</Expander>


				<Expander Style="{StaticResource PropertiesExpanderStyle}">
					<Expander.Header>
						<TextBlock Text="Again header goes here" />
					</Expander.Header>

					<Expander.Content>
						<StackPanel
							HorizontalAlignment="Stretch"
							Background="#1100FF00"
							Orientation="Vertical">
							<TextBlock Height="48" Text="Item 1 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 2 in the stack" />
							<MenuFlyoutSeparator />
							<TextBlock Height="48" Text="Item 3 in the stack" />
						</StackPanel>
					</Expander.Content>
				</Expander>
			</StackPanel>
		</ScrollViewer>

	</Grid>

</Page>
